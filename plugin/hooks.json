{
  "hydrogen-harness": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/dist/entry/hook-cli.js\""
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/dist/entry/hook-cli.js\""
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(read_file|view_file|write_file|write_to_file|edit_file|replace_file_content|multi_replace_file_content|sed_file|notebook_edit|run_command|send_command_input|command_status|notebook_execution|manage_task|schedule|invoke_subagent|define_subagent|manage_subagents|send_message|swarm|run_workflow|call_mcp_tool)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$PLUGIN_ROOT/dist/entry/hook-cli.js\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/dist/entry/hook-cli.js\""
      }
    ]
  }
}
